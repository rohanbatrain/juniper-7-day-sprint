{#
  Base configuration every lab node boots with.
  Rendered by ops/lab-gen.py into the FAT config disk (config/juniper.conf),
  merged with the node's startup_config from the topology, if any.

  Placeholders: {HOSTNAME} {MGMT_IP_IPV4} {MGMT_GW_IP_IPV4}
#}
system {
    host-name {HOSTNAME};
    root-authentication {
        plain-text-password-value "admin@123";
    }
    login {
        user admin {
            class super-user;
            authentication {
                plain-text-password-value "admin@123";
            }
        }
    }
    services {
        ssh {
            root-login allow;
        }
        netconf {
            ssh;
        }
    }
    management-instance;
}
chassis {
    fpc 0 {
        pic 0 {
            number-of-ports {PORTS};
        }
    }
}
interfaces {
    fxp0 {
        unit 0 {
            family inet {
                address {MGMT_IP_IPV4};
            }
        }
    }
}
routing-instances {
    mgmt_junos {
        routing-options {
            static {
                route 0.0.0.0/0 next-hop {MGMT_GW_IP_IPV4};
            }
        }
    }
}
